{
  "info":  {
    "_postman_id":  "9d0f7f89-ef4a-4ccf-8d8b-6f0ebf4b71e2",
    "name":  "BarberFlow - Funcionalidades Completas",
    "description":  "Collection completa da API BarberFlow com todas as funcionalidades de Clientes, Barbeiros, Horarios e Agendamentos.",
    "schema":  "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item":  [
    {
      "name":  "Clientes",
      "item":  [
        {
          "name":  "Cadastrar Cliente",
          "request":  {
            "method":  "POST",
            "header":  [
              {
                "key":  "Content-Type",
                "value":  "application/json"
              }
            ],
            "body":  {
              "mode":  "raw",
              "raw":  "{\n  \"nome\": \"{{nomeCliente}}\",\n  \"telefone\": \"{{telefoneCliente}}\",\n  \"senha\": \"{{senhaCliente}}\"\n}",
              "options":  {
                "raw":  {
                  "language":  "json"
                }
              }
            },
            "url":  "{{base_url}}/clientes",
            "description":  "Cria um novo cliente e salva o ID retornado em {{clienteId}}."
          },
          "event":  [
            {
              "listen":  "test",
              "script":  {
                "type":  "text/javascript",
                "exec":  [
                  "pm.test(\u0027Status 201\u0027, function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "if (data \u0026\u0026 data.id) { pm.collectionVariables.set(\u0027clienteId\u0027, String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name":  "Listar Clientes",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/clientes",
            "description":  "Lista todos os clientes."
          }
        },
        {
          "name":  "Buscar Cliente por ID",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/clientes/{{clienteId}}",
            "description":  "Consulta cliente pelo ID salvo em {{clienteId}}."
          }
        },
        {
          "name":  "Buscar Cliente por Nome/Telefone",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/clientes?busca={{buscaCliente}}",
            "description":  "Busca cliente por nome ou telefone com o parametro busca."
          }
        },
        {
          "name":  "Atualizar Cliente",
          "request":  {
            "method":  "PUT",
            "header":  [
              {
                "key":  "Content-Type",
                "value":  "application/json"
              }
            ],
            "body":  {
              "mode":  "raw",
              "raw":  "{\n  \"nome\": \"{{nomeClienteAtualizado}}\",\n  \"telefone\": \"{{telefoneCliente}}\",\n  \"senha\": \"{{senhaCliente}}\"\n}",
              "options":  {
                "raw":  {
                  "language":  "json"
                }
              }
            },
            "url":  "{{base_url}}/clientes/{{clienteId}}",
            "description":  "Atualiza dados do cliente selecionado."
          }
        },
        {
          "name":  "Remover Cliente",
          "request":  {
            "method":  "DELETE",
            "url":  "{{base_url}}/clientes/{{clienteId}}",
            "description":  "Exclui cliente pelo ID."
          }
        }
      ]
    },
