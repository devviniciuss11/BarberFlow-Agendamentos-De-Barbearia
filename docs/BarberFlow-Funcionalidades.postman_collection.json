    {
      "name":  "Horarios",
      "item":  [
        {
          "name":  "Cadastrar Horario Disponivel",
          "request":  {
            "method":  "POST",
            "header":  [
              {
                "key":  "Content-Type",
                "value":  "application/json"
              }
            ],
            "body":  {
              "mode":  "raw",
              "raw":  "{\n  \"barbeiroid\": {{barbeiroId}},\n  \"data\": \"{{dataAgendamento}}\",\n  \"hora\": \"{{horaHorario}}\",\n  \"disponivel\": true\n}",
              "options":  {
                "raw":  {
                  "language":  "json"
                }
              }
            },
            "url":  "{{base_url}}/Horarios",
            "description":  "Cadastra horario disponivel para o barbeiro informado."
          },
          "event":  [
            {
              "listen":  "test",
              "script":  {
                "type":  "text/javascript",
                "exec":  [
                  "pm.test(\u0027Status 201\u0027, function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "if (data \u0026\u0026 data.id) { pm.collectionVariables.set(\u0027horarioId\u0027, String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name":  "Listar Horarios Disponiveis",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/Horarios/disponiveis?barbeiroId={{barbeiroId}}\u0026clienteId={{clienteId}}\u0026data={{dataAgendamento}}",
            "description":  "Lista horarios disponiveis considerando a regra de pontos do cliente."
          }
        }
      ]
    },
    {
      "name":  "Agendamentos",
      "item":  [
        {
          "name":  "Criar Agendamento",
          "request":  {
            "method":  "POST",
            "header":  [
              {
                "key":  "Content-Type",
                "value":  "application/json"
              }
            ],
            "body":  {
              "mode":  "raw",
              "raw":  "{\n  \"nomeCliente\": \"{{nomeClienteAtualizado}}\",\n  \"telefoneCliente\": \"{{telefoneCliente}}\",\n  \"telefoneBarbeiro\": \"{{telefoneBarbeiro}}\",\n  \"data\": \"{{dataAgendamento}}\",\n  \"hora\": \"{{horaAgendamento}}\"\n}",
              "options":  {
                "raw":  {
                  "language":  "json"
                }
              }
            },
            "url":  "{{base_url}}/agendamentos",
            "description":  "Cria agendamento e salva ID em {{agendamentoId}}."
          },
          "event":  [
            {
              "listen":  "test",
              "script":  {
                "type":  "text/javascript",
                "exec":  [
                  "pm.test(\u0027Status 201\u0027, function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "if (data \u0026\u0026 data.id) { pm.collectionVariables.set(\u0027agendamentoId\u0027, String(data.id)); }"
                ]
              }
            }
          ]
        },
        {
          "name":  "Buscar Agendamento por ID",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/agendamentos/{{agendamentoId}}",
            "description":  "Consulta agendamento pelo ID salvo em {{agendamentoId}}."
          }
        },
        {
          "name":  "Buscar Agendamentos por Telefone do Barbeiro",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/agendamentos/barbeiro/buscar?telefoneBarbeiro={{telefoneBarbeiro}}",
            "description":  "Retorna todos os agendamentos do barbeiro."
          }
        },
        {
          "name":  "Listar Agendamentos Ativos do Barbeiro",
          "request":  {
            "method":  "GET",
            "url":  "{{base_url}}/agendamentos/barbeiro/listar?telefoneBarbeiro={{telefoneBarbeiro}}",
            "description":  "Lista agendamentos nao cancelados e nao concluidos."
          }
        },
        {
          "name":  "Cancelar Agendamento pelo Cliente",
          "request":  {
            "method":  "PATCH",
            "url":  "{{base_url}}/agendamentos/{{agendamentoId}}/cancelar/cliente?senhaCliente={{senhaCliente}}",
            "description":  "Cancela agendamento usando senha do cliente."
          }
        },
        {
          "name":  "Cancelar Agendamento pelo Barbeiro",
          "request":  {
            "method":  "PATCH",
            "url":  "{{base_url}}/agendamentos/{{agendamentoId}}/cancelar/barbeiro?senhaBarbeiro={{senhaBarbeiro}}",
            "description":  "Cancela agendamento usando senha do barbeiro."
          }
        },
        {
          "name":  "Concluir Agendamento",
          "request":  {
            "method":  "PATCH",
            "url":  "{{base_url}}/agendamentos/{{agendamentoId}}/concluir?senhaBarbeiro={{senhaBarbeiro}}",
            "description":  "Conclui agendamento e incrementa pontos do cliente."
          }
        }
      ]
    }
